ex:Evidence1 a ex:EvidenceRecord ; ex:fromSource ex:Source1 ; ex:sourceSpan "p. 2, target paragraph" .
ex:Claim1 a ex:Claim ; ex:about ex:AssetA ; ex:supportedBy ex:Evidence1 ; ex:text "Asset A has a reviewed target hypothesis." ; ex:reviewState "supported" ; ex:reviewer "R. Singh" ; ex:reviewedOn "2026-09-03" .
ex:Claim2 a ex:Claim ; ex:about ex:AssetA ; ex:text "Asset A has an unsupported commercial claim." ; ex:reviewState "unknown" ; ex:reviewer "R. Singh" ; ex:reviewedOn "2026-09-03" .
ex:Claim3 a ex:Claim ; ex:about ex:AssetA ; ex:text "Asset A's target is validated by every source." ; ex:reviewState "conflicting" ; ex:reviewer "R. Singh" ; ex:reviewedOn "2026-09-03" .
