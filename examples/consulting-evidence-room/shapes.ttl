@prefix ex: <https://ontology-starterkit.dev/consulting/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:AssetShape a sh:NodeShape ; sh:targetClass ex:Asset ; sh:property [ sh:path ex:name ; sh:datatype xsd:string ; sh:minCount 1 ] ; sh:property [ sh:path ex:forIndication ; sh:class ex:Indication ; sh:minCount 1 ] .
ex:IndicationShape a sh:NodeShape ; sh:targetClass ex:Indication ; sh:property [ sh:path ex:name ; sh:datatype xsd:string ; sh:minCount 1 ] .
ex:EvidenceShape a sh:NodeShape ; sh:targetClass ex:EvidenceRecord ; sh:property [ sh:path ex:fromSource ; sh:class ex:Source ; sh:minCount 1 ] .
ex:ClaimShape a sh:NodeShape ; sh:targetClass ex:Claim ; sh:property [ sh:path ex:about ; sh:class ex:Asset ; sh:minCount 1 ] ; sh:property [ sh:path ex:supportedBy ; sh:class ex:EvidenceRecord ] ; sh:property [ sh:path ex:text ; sh:datatype xsd:string ; sh:minCount 1 ] ; sh:property [ sh:path ex:reviewState ; sh:in ( "supported" "unknown" "conflicting" "stale" ) ; sh:minCount 1 ] ; sh:property [ sh:path ex:reviewer ; sh:datatype xsd:string ; sh:minCount 1 ] ; sh:property [ sh:path ex:reviewedOn ; sh:datatype xsd:string ; sh:minCount 1 ] .
ex:SourceShape a sh:NodeShape ; sh:targetClass ex:Source ; sh:property [ sh:path ex:name ; sh:datatype xsd:string ; sh:minCount 1 ] ; sh:property [ sh:path ex:sourceVersion ; sh:datatype xsd:string ; sh:minCount 1 ] ; sh:property [ sh:path ex:publishedOn ; sh:datatype xsd:string ; sh:minCount 1 ] ; sh:property [ sh:path ex:retrievedOn ; sh:datatype xsd:string ; sh:minCount 1 ] .
