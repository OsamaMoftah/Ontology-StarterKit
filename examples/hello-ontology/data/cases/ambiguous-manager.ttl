@prefix ex: <https://ontology-starterkit.dev/hello/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Maya a ex:Person ; ex:name "Maya Chen"^^xsd:string ; ex:manages ex:Aurora .
